{
  "$schema": "https://charm.land/crush.json",
  "options": {
    "attribution": {
      "trailer_style": "none",
      "generated_with": false
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^bash$",
        "command": "{{ .chezmoi.homeDir }}/.config/crush/hooks/rtk-rewrite.sh"
      },
      {
        "matcher": "^bash$",
        "command": "{{ .chezmoi.homeDir }}/.config/crush/hooks/guard-git-gh.sh"
      },
      {
        "matcher": "^(edit|write|multiedit)$",
        "command": "{{ .chezmoi.homeDir }}/.config/crush/hooks/guard-write.sh"
      },
      {
        "matcher": "^view$",
        "command": "{{ .chezmoi.homeDir }}/.config/crush/hooks/mark-skill.sh"
      }
    ]
  }
}
