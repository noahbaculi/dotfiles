#!/bin/sh
# vim: filetype=sh

{{- if eq .chezmoi.os "linux" "darwin" }}

echo "Installing common packages for Linux, WSL, and MacOS..."

# Ensure mise is on PATH even before shell config is sourced (first-run bootstrap)
export PATH="$HOME/.local/bin:$HOME/.local/share/mise/bin:$HOME/.cargo/bin:/opt/homebrew/bin:$PATH"

# Authenticated GitHub API calls avoid the rate limit that makes cargo-binstall
# compile from source and aqua fail attestation checks on shared egress IPs
if command -v gh >/dev/null && gh auth status >/dev/null 2>&1; then
	GITHUB_TOKEN=$(gh auth token)
	export GITHUB_TOKEN
fi

# Install from mise/config.toml
mise install

# Delete the default neovim themes
find ~/.local/share/mise/installs/neovim/ -type f -path "*/colors/*" ! -name "*README*" ! -name "default.vim" ! -name "vim.lua" -delete
{{- end }}

{{- if eq .chezmoi.os "linux" }}

echo "Installing packages for Linux..."
sudo apt install git mosh

# Symlink mise's neovim shim to /usr/local/bin so sudoedit can find nvim
# Using the shim (not the versioned path) ensures this works across mise updates
echo "Symlinking mise neovim to /usr/local/bin/nvim"
sudo ln -sf ~/.local/share/mise/shims/nvim /usr/local/bin/nvim
{{- end }}

{{- if eq .chezmoi.os "darwin" }}

echo "Installing packages for MacOS..."

brew install gnu-sed wget mosh

# One invocation fetches everything first, then installs back to back so the
# pkg casks share a single sudo prompt. Comment a line out to skip it
grep -v '^#' <<-EOF | xargs brew install --cask
	google-chrome
	firefox
	ghostty
	font-symbols-only-nerd-font
	karabiner-elements
	maccy
	# espanso: native macOS text replacement covers it for now
	obsidian
	balenaetcher
	veracrypt
	vlc
	logi-options+
	betterdisplay
	xykong/tap/flux-markdown
	smoothcsv
EOF
{{- end }}

