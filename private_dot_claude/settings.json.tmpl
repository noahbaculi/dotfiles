{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "defaultMode": "auto"
  },
{{- if .work }}
  "model": "opus",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "xhigh"
    },
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
{{- else }}
  "model": "sonnet",
  "effortLevel": "medium",
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
{{- end }}
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/crush/hooks/remind-code-comments.sh"
          },
          {
            "type": "command",
            "command": "~/.config/crush/hooks/remind-github-md.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.command' | grep -qiE 'github\\.com' && echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"Use gh api or other gh subcommands instead of curl for GitHub API requests. This avoids token/rate-limit issues and uses your gh auth credentials.\"}}' || true",
            "if": "Bash(curl:*)",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "~/.config/crush/hooks/remind-gh-collab.sh"
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "{{ if .work }}NODE_USE_SYSTEM_CA=1 {{ end }}bun ~/.local/share/mise/installs/npm-ccstatusline/latest/node_modules/ccstatusline/dist/ccstatusline.js --hook"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{ if .work }}NODE_USE_SYSTEM_CA=1 {{ end }}bun ~/.local/share/mise/installs/npm-ccstatusline/latest/node_modules/ccstatusline/dist/ccstatusline.js --hook"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "{{ if .work }}NODE_USE_SYSTEM_CA=1 {{ end }}bun ~/.local/share/mise/installs/npm-ccstatusline/latest/node_modules/ccstatusline/dist/ccstatusline.js",
    "padding": 0,
    "refreshInterval": 10
  },
  "extraKnownMarketplaces": {
    "zj-radar": {
      "source": {
        "source": "github",
        "repo": "marktoda/zj-radar",
        "ref": "v0.11.0"
      }
    }
  },
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "zj-radar-claude@zj-radar": true
  },
  "syntaxHighlightingDisabled": false,
  "tui": "fullscreen",
  "voice": {
    "enabled": false,
    "mode": "hold"
  },
  "theme": "auto",
  "editorMode": "normal",
  "autoCompactEnabled": false,
  "agentPushNotifEnabled": false,
  "voiceEnabled": false,
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false
}
