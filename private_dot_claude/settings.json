{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "sonnet",
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/crush/hooks/remind-code-comments.sh"
          },
          {
            "type": "command",
            "command": "~/.config/crush/hooks/remind-github-md.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.command' | grep -qiE 'github\\.com' && echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"Use gh api or other gh subcommands instead of curl for GitHub API requests. This avoids token/rate-limit issues and uses your gh auth credentials.\"}}' || true",
            "if": "Bash(curl:*)",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "~/.config/crush/hooks/remind-gh-collab.sh"
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "bun ~/.local/share/mise/installs/npm-ccstatusline/latest/node_modules/ccstatusline/dist/ccstatusline.js --hook"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$ZELLIJ\" ] && zellij pipe --name \"zellij-attention::waiting::$ZELLIJ_PANE_ID\" || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$ZELLIJ\" ] && zellij pipe --name \"zellij-attention::completed::$ZELLIJ_PANE_ID\" || true"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun ~/.local/share/mise/installs/npm-ccstatusline/latest/node_modules/ccstatusline/dist/ccstatusline.js --hook"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bun ~/.local/share/mise/installs/npm-ccstatusline/latest/node_modules/ccstatusline/dist/ccstatusline.js",
    "padding": 0,
    "refreshInterval": 10
  },
  "extraKnownMarketplaces": {
    "zj-radar": {
      "source": {
        "source": "github",
        "repo": "marktoda/zj-radar",
        "ref": "v0.11.0"
      }
    }
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "zj-radar-claude@zj-radar": true
  },
  "syntaxHighlightingDisabled": false,
  "effortLevel": "medium",
  "tui": "fullscreen",
  "voice": {
    "enabled": false,
    "mode": "hold"
  },
  "theme": "auto",
  "editorMode": "normal",
  "autoCompactEnabled": false,
  "agentPushNotifEnabled": false,
  "voiceEnabled": false
}
