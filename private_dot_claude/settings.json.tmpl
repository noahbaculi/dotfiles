{
{{- if not .work }}
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
{{- end }}
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "defaultMode": "auto",
    "ask": [
      "mcp__claude_ai_Slack",
      "mcp__claude_ai_Gmail",
      "mcp__claude_ai_Atlassian__addCommentToJiraIssue",
      "mcp__claude_ai_Atlassian__addWorklogToJiraIssue",
      "mcp__claude_ai_Atlassian__createJiraIssue",
      "mcp__claude_ai_Atlassian__createIssueLink",
      "mcp__claude_ai_Atlassian__editJiraIssue",
      "mcp__claude_ai_Atlassian__transitionJiraIssue",
      "mcp__claude_ai_Atlassian__createConfluencePage",
      "mcp__claude_ai_Atlassian__updateConfluencePage",
      "mcp__claude_ai_Atlassian__createConfluenceFooterComment",
      "mcp__claude_ai_Atlassian__createConfluenceInlineComment",
      "mcp__claude_ai_Atlassian__createCompassComponent",
      "mcp__claude_ai_Atlassian__createCompassComponentRelationship",
      "mcp__claude_ai_Atlassian__createCompassCustomFieldDefinition",
      "mcp__claude_ai_Google_Drive__share_file",
      "mcp__claude_ai_Lucid__post_document_thread_comment"
    ]
  },
{{- if .work }}
  "model": "opus",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "xhigh"
    },
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
{{- else }}
  "model": "opus",
{{- end }}
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/crush/hooks/guard-write.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/crush/hooks/guard-git-gh.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "{{ if .work }}NODE_USE_SYSTEM_CA=1 {{ end }}bun ~/.local/share/mise/installs/npm-ccstatusline/latest/node_modules/ccstatusline/dist/ccstatusline.js --hook"
          },
          {
            "type": "command",
            "command": "~/.config/crush/hooks/mark-skill.sh"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/crush/hooks/mark-skill.sh",
            "if": "Read(**/SKILL.md)"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{ if .work }}NODE_USE_SYSTEM_CA=1 {{ end }}bun ~/.local/share/mise/installs/npm-ccstatusline/latest/node_modules/ccstatusline/dist/ccstatusline.js --hook"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "{{ if .work }}NODE_USE_SYSTEM_CA=1 {{ end }}bun ~/.local/share/mise/installs/npm-ccstatusline/latest/node_modules/ccstatusline/dist/ccstatusline.js",
    "padding": 0,
    "refreshInterval": 10
  },
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "zj-radar-claude@zj-radar": true
  },
  "extraKnownMarketplaces": {
    "zj-radar": {
      "source": {
        "source": "github",
        "repo": "marktoda/zj-radar",
        "ref": "v0.12.0"
      }
    }
  },
  "syntaxHighlightingDisabled": false,
{{- if not .work }}
  "effortLevel": "medium",
{{- end }}
  "tui": "fullscreen",
  "voice": {
    "enabled": false,
    "mode": "hold"
  },
  "theme": "auto",
  "editorMode": "normal",
  "autoCompactEnabled": false,
  "agentPushNotifEnabled": false,
  "voiceEnabled": false
}
