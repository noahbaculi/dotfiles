{{/* Coding fonts for GUI machines. macOS is always a GUI client; Linux
     machines opt in via the gui flag. Pinned versions: bump the
     URL to upgrade, chezmoi re-downloads when the URL changes. */}}
{{- $fontDir := ".local/share/fonts" }}
{{- if eq .chezmoi.os "darwin" }}{{- $fontDir = "Library/Fonts" }}{{- end }}
{{- if or (eq .chezmoi.os "darwin") (and (eq .chezmoi.os "linux") .gui) }}
["{{ $fontDir }}/MapleMono"]
    type = "archive"
    url = "https://github.com/subframe7536/maple-font/releases/download/v7.9/MapleMono-Variable.zip"

["{{ $fontDir }}/Monaspace"]
    type = "archive"
    url = "https://github.com/githubnext/monaspace/releases/download/v1.400/monaspace-static-v1.400.zip"
{{- end }}

{{- if .dev_env }}

{{/* Agent status rail, loaded only by the compact-top-radar layout. Bump
     together with the zj-radar CLI pin in mise, using the release's .sha256. */}}
[".config/zellij/plugins/zj_radar.wasm"]
    type = "file"
    url = "https://github.com/marktoda/zj-radar/releases/download/v0.11.0/zj_radar.wasm"
    checksum.sha256 = "36192b742a840432d58ac1e1eaed47076a19b79adc8191d2284499470faaf0e1"

[".agents/skills/chezmoi"]
    type = "git-repo"
    url = "https://github.com/cosgroveb/chezmoi-skill.git"
    refreshPeriod = "168h"
    clone.args = ["--depth", "1"]
    pull.args = ["--ff-only"]

